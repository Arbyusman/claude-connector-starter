{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["markitdown", "docling", "figma-console"],
  "env": {
    "MAX_MCP_OUTPUT_TOKENS": "15000",
    "BASH_MAX_OUTPUT_LENGTH": "20000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "permissions": {
    "allow": [
      "mcp__markitdown__convert_to_markdown",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(ls:*)",
      "Bash(py -3.12 -m pip show:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/node_modules/**)",
      "Read(./**/__pycache__/**)",
      "Read(./**/*.pyc)"
    ]
  }
}
