# Copy to connectors/.env and fill in, or let install.ps1 prompt you.
#
# Figma personal access token. Create at:
#   https://help.figma.com/hc/en-us/articles/8085703771159-Manage-personal-access-tokens
# Scopes: File content (Read), File versions (Read), Variables (Read), Comments (Read and write).
# Starts with "figd_".
FIGMA_ACCESS_TOKEN=figd_YOUR_TOKEN_HERE

# Set to "true" to expose Figma MCP Apps UI in supporting clients.
ENABLE_MCP_APPS=true
