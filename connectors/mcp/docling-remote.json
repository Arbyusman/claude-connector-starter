{
  "docling": {
    "command": "uvx",
    "args": [
      "--from",
      "docling-mcp",
      "docling-mcp-server",
      "--transport",
      "stdio"
    ],
    "env": {
      "DOCLING_MCP_CONVERSION_MODE": "remote",
      "DOCLING_MCP_SERVICE_URL": "https://YOUR-DOCLING-SERVE-HOST",
      "DOCLING_MCP_SERVICE_API_KEY": "YOUR_API_KEY",
      "DOCLING_MCP_FALLBACK_TO_LOCAL": "false",
      "DOCLING_MCP_KEEP_IMAGES": "false",
      "DOCLING_MCP_IMAGE_EXPORT_MODE": "placeholder"
    }
  }
}
